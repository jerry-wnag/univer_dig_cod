  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", 
    RowBox[{"\"\<=== TCCT Topological XOR Gate TestBench ===\>\"", ",", 
     "White", ",", "Bold", ",", "16", ",", 
     RowBox[{"Background", "->", "Black"}]}], "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testCases", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"results", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"graphs", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"inA", "=", 
       RowBox[{"testCases", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"inB", "=", 
       RowBox[{"testCases", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "1", "\:6b65\:5e76\:53d1\:78b0\:649e\:5373\:53ef\:5b8c\:6210\:5c40\
\:90e8\:77ed\:8def\:4e0e\:76f8\:6d88\:5e72\:6d89"}], "*)"}], 
      RowBox[{"finalG", "=", 
       RowBox[{"RunXORTest", "[", 
        RowBox[{"inA", ",", "inB", ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"outC", "=", 
       RowBox[{"MeasureOutput", "[", "finalG", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"results", ",", 
        RowBox[{"{", 
         RowBox[{"inA", ",", "inB", ",", "outC"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"graphs", ",", "finalG"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"StringForm", "[", 
          
          RowBox[{"\"\<Input (A:``, B:``) -> Output C: ``\>\"", ",", "inA", ",",
            "inB", ",", "outC"}], "]"}], ",", "14", ",", "Bold", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"outC", "==", "1"}], ",", "Green", ",", "Red"}], "]"}]}], 
        "]"}], "]"}], ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{
  "(*", "\:6e32\:67d3\:56db\:7ec4\:53e0\:52a0\:6001\:574d\:7f29\:540e\:7684\
\:5b8f\:89c2\:62d3\:6251\:56fe\:8c31", "*)"}]}], "\[IndentingNewLine]", 
