Reject61Trace77A[
c_List,
horizon_Integer?Positive
]:=Module[
{
p,pa,id,od,q,n,pin,pout,cin,cout,h,z,h2,nz,j,k,
aps,ap,pz,o,zv,rf,rd,dd,pg,allow,active=0,
rej={},rounds=0,terminatedNaturally=False
},
p=Pack60[c];
pa=p[[1]];
id=p[[2]];
od=p[[3]];
q=p[[4]];
n=p[[7]];
pin=p[[8]];
pout=p[[9]];
cin=p[[10]];
cout=p[[11]];
h=ConstantArray[0,n];
z=ConstantArray[0,n];
h[[q]]=1;
For[
k=1,
k<=horizon,
k++,
rounds=k;
h2=ConstantArray[0,n];
nz=ConstantArray[0,n];
active=0;
Do[
aps=Select[
pa[[j]],
Function[u,u>0&&h[[u]]==1]
];
ap=Length[aps];
If[
ap>0,
pz=Max[z[[aps]]];
o=Boole[ap>1];
zv={0,1,2,1,3,1,3,1}[[1+2*pz+o]];
nz[[j]]=zv;
rf={
1,
Boole[zv>0],
zv,
Sign[pin[[j]]-id[[j]]],
Sign[pout[[j]]-id[[j]]],
Sign[cin[[j]]-id[[j]]],
Sign[cout[[j]]-od[[j]]],
Sign[id[[j]]-od[[j]]],
Sign[pout[[j]]-cin[[j]]]
};
rd=rw60.rf;
dd=1-cin[[j]]+2*cout[[j]];
pg=od[[j]]+2*Boole[zv>0]-zv;
If[
rd>0&&dd<=0,
AppendTo[rej,{k,j}]
];
allow=If[rd>0,dd>0,pg>0];
If[
TrueQ[allow],
h2[[j]]=1;
active++
]
],
{j,n}
];
h=h2;
z=nz;
If[
active==0,
terminatedNaturally=True;
Break[]
]
];
<|
"Rejects"->rej,
"RoundsExecuted"->rounds,
"TerminatedNaturally"->terminatedNaturally,
"HitHorizon"->And[
!TrueQ[terminatedNaturally],
SameQ[rounds,horizon]
],
"ActiveAfterLastRound"->active,
"Horizon"->horizon
|>
];

RejectsThroughHorizon77A[
trace_Association,
horizon_Integer?((#>=0)&)
]:=Select[
trace["Rejects"],
#[[1]]<=horizon&
];

DecisionStatePairsFromRejects77A[
c_List,
rej_List
]:=Module[{levels,nodes},
If[Length[rej]==0,Return[{}]];
levels=SigLevels61[c,3];
nodes=rej[[All,2]];
DeleteDuplicates[
Map[
Function[node,
{
Lookup[levels[[3]],node],
Lookup[levels[[4]],node]
}
],
nodes
]
]
];

EncodeStatePairs77A[pairs_List]:=First[
EncodeRows75[
{
<|
"Grammar"->"S77A_Audit",
"Depth"->0,
"Answer"->0,
"Target"->"AuditOnly",
"StatePairs"->pairs
|>
},
frozen75D["Params"],
frozen75D["K"]
]
]["Codes"];

PredictCodes77A[codes_List]:=If[
AnyTrue[
codes,
MemberQ[frozen75D["Policy"],#]&
],
"Continue",
"Stop"
];

BuildAuditCases77A[depths_List]:=Flatten[
Table[
<|
"Grammar"->topology,
"Depth"->depth,
"Answer"->answer,
"Target"->target,
"Case"->CaseByTopology77[
topology,
depth,
answer,
target
]
|>,
{topology,referenceTopologies77A},
{depth,depths},
{answer,Range[4]},
{target,{"Continue","Stop"}}
],
3
];

AuditScaleCase77A[record_Association]:=Module[
{
traceSeconds,trace,allRejects,firstRejectRound,lastRejectRound,
horizonRows,rejects,pairs,codes,prediction,recoveredRows
},
{traceSeconds,trace}=AbsoluteTiming[
Reject61Trace77A[record["Case"],maxHorizon77A]
];
allRejects=trace["Rejects"];
firstRejectRound=If[
Length[allRejects]>0,
Min[allRejects[[All,1]]],
Missing["NoRejectThroughMaximumHorizon"]
];
lastRejectRound=If[
Length[allRejects]>0,
Max[allRejects[[All,1]]],
Missing["NoRejectThroughMaximumHorizon"]
];
horizonRows=Map[
Function[horizon,
rejects=RejectsThroughHorizon77A[trace,horizon];
pairs=DecisionStatePairsFromRejects77A[
record["Case"],
rejects
];
codes=EncodeStatePairs77A[pairs];
prediction=PredictCodes77A[codes];
<|
"Grammar"->record["Grammar"],
"Depth"->record["Depth"],
"Answer"->record["Answer"],
"Target"->record["Target"],
"Horizon"->horizon,
"RejectCount"->Length[rejects],
"StatePairCount"->Length[pairs],
"StatePairsNonEmpty"->(Length[pairs]>0),
"StatePairHash"->Hash[pairs,"SHA256","HexString"],
"Codes"->codes,
"Prediction"->prediction,
"Correct"->SameQ[prediction,record["Target"]],
"TraceTerminatedNaturallyAtMaximum"->
trace["TerminatedNaturally"],
"TraceHitMaximumHorizon"->trace["HitHorizon"]
|>
],
horizonSuite77A
];
recoveredRows=Select[
horizonRows,
TrueQ[# ["StatePairsNonEmpty"]]&
];
<|
"Grammar"->record["Grammar"],
"Depth"->record["Depth"],
"Answer"->record["Answer"],
"Target"->record["Target"],
"TraceSeconds"->traceSeconds,
"RoundsExecuted"->trace["RoundsExecuted"],
"TerminatedNaturally"->trace["TerminatedNaturally"],
"HitMaximumHorizon"->trace["HitHorizon"],
"ActiveAfterLastRound"->trace["ActiveAfterLastRound"],
"TotalRejectCount"->Length[allRejects],
"FirstRejectRound"->firstRejectRound,
"LastRejectRound"->lastRejectRound,
"FirstCandidateRecoveryHorizon"->If[
Length[recoveredRows]>0,
First[recoveredRows]["Horizon"],
Missing["NotRecovered"]
],
"HorizonRows"->horizonRows
|>
];

AuditScaleDepth77A[depth_Integer]:=
AuditScaleCase77A/@BuildAuditCases77A[{depth}];

ScaleDepthSummary77A[caseRows_List]:=Module[
{flatRows},
flatRows=Flatten[Lookup[caseRows,"HorizonRows"],1];
Map[
Function[horizon,
Module[{selected,cases,passed,nonEmpty},
selected=Select[
flatRows,
SameQ[# ["Horizon"],horizon]&
];
cases=Length[selected];
passed=Count[selected,row_/;TrueQ[row["Correct"]]];
nonEmpty=Count[
selected,
row_/;TrueQ[row["StatePairsNonEmpty"]]
];
<|
"Depth"->First[selected]["Depth"],
"Horizon"->horizon,
"Cases"->cases,
"NonEmptyStatePairs"->nonEmpty,
"EmptyStatePairs"->(cases-nonEmpty),
"Passed"->passed,
"Accuracy"->N[passed/cases],
"TracesTerminatedNaturallyAtMaximum"->Count[
selected,
row_/;TrueQ[
row["TraceTerminatedNaturallyAtMaximum"]
]
],
"TracesHitMaximumHorizon"->Count[
selected,
row_/;TrueQ[row["TraceHitMaximumHorizon"]]
]
|>
]
],
horizonSuite77A
]
];

