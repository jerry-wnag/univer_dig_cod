SetDirectory[DirectoryName[$InputFileName]];
source75D=Import[
"TCCT_S75D_ValidatedPolicyCompletionCheckpoint.wl",
"Text"
];
parsed75D=Quiet@Check[
ToExpression[
"HoldComplete["<>source75D<>"]",
InputForm,
HoldComplete
],
$Failed
];
Print[<|
"SyntaxParsed"->(parsed75D=!=$Failed),
"SourceCharacters"->StringLength[source75D]
|>];
Quit[If[parsed75D===$Failed,1,0]];
