"UsesRevealedS92Labels"->True,
"RequiresTwoMatchedAlternativeWorldsAtInference"->True,
"ReadsCardinalityFeatures"->False,
"S93DesignedBeforeFreeze"->False,"S93DataReadBeforeFreeze"->False,
