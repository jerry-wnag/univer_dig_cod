checkpointPath="E:/engine_wolf/TCCT_S94H_R3_Checkpoints/scenario_02.wxf";
obj=Quiet@Check[Import[checkpointPath,"WXF"],$Failed];
recomputedHash=If[AssociationQ[obj],
Hash[Normal@KeyDrop[obj,{"CheckpointHash"}],"SHA256","HexString"],Missing[]];
Print[<|
"Association"->AssociationQ[obj],
"Keys"->If[AssociationQ[obj],Keys[obj],{}],
"Stage"->If[AssociationQ[obj],Lookup[obj,"Stage",Missing[]],Missing[]],
"HarnessRevision"->If[AssociationQ[obj],Lookup[obj,"HarnessRevision",Missing[]],Missing[]],
"ScenarioIndex"->If[AssociationQ[obj],Lookup[obj,"ScenarioIndex",Missing[]],Missing[]],
"Scenario"->If[AssociationQ[obj],Lookup[obj,"Scenario",Missing[]],Missing[]],
"PairCount"->If[AssociationQ[obj],Lookup[obj,"PairCount",Missing[]],Missing[]],
"WorldCount"->If[AssociationQ[obj],Lookup[obj,"WorldCount",Missing[]],Missing[]],
"PairsLength"->If[AssociationQ[obj],Length@Lookup[obj,"Pairs",{}],0],
"PairsAssociations"->If[AssociationQ[obj],
VectorQ[Lookup[obj,"Pairs",{}],AssociationQ],False],
"ScenarioValidityPassed"->If[AssociationQ[obj],
Lookup[obj,"ScenarioValidityPassed",Missing[]],Missing[]],
"CandidateHash"->If[AssociationQ[obj],Lookup[obj,"CandidateHash",Missing[]],Missing[]],
"CandidateFileHash"->If[AssociationQ[obj],
Lookup[obj,"CandidateFileHash",Missing[]],Missing[]],
"ProtocolHash"->If[AssociationQ[obj],Lookup[obj,"ProtocolHash",Missing[]],Missing[]],
"DefinitionHash"->If[AssociationQ[obj],
Lookup[obj,"DefinitionHash",Missing[]],Missing[]],
"StoredHash"->If[AssociationQ[obj],Lookup[obj,"CheckpointHash",Missing[]],Missing[]],
"RecomputedHash"->recomputedHash,
"HashMatched"->If[AssociationQ[obj],
SameQ[Lookup[obj,"CheckpointHash",Missing[]],recomputedHash],False]
|>];
Quit[];
