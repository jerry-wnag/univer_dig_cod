prediction=PredictCodes78[codes];
statePairHash=Hash[pairs,"SHA256","HexString"];
firstRejectRound=If[
Length[allRejects]>0,
Min[allRejects[[All,1]]],
Missing["NoReject"]
];
referenceRow=SelectFirst[
maxHorizonRows77A,
And[
SameQ[# ["Grammar"],record["Grammar"]],
SameQ[# ["Depth"],record["Depth"]],
SameQ[# ["Answer"],record["Answer"]],
SameQ[# ["Target"],record["Target"]]
]&,
Missing["ReferenceRowNotFound"]
];
referenceTraceRow=SelectFirst[
scaleAuditRows77A,
And[
SameQ[# ["Grammar"],record["Grammar"]],
SameQ[# ["Depth"],record["Depth"]],
SameQ[# ["Answer"],record["Answer"]],
SameQ[# ["Target"],record["Target"]]
]&,
Missing["ReferenceTraceNotFound"]
];
referenceFound=AssociationQ[referenceRow];
referenceTraceFound=AssociationQ[referenceTraceRow];
<|
"Grammar"->record["Grammar"],
"Depth"->record["Depth"],
"Answer"->record["Answer"],
"Target"->record["Target"],
"TraceSeconds"->traceSeconds,
"PackedNodeCount"->trace["PackedNodeCount"],
"SafetyCap"->trace["SafetyCap"],
"RoundsExecuted"->trace["RoundsExecuted"],
"TerminatedNaturally"->trace["TerminatedNaturally"],
"HitSafetyCap"->trace["HitSafetyCap"],
"RejectCount"->Length[allRejects],
"FirstRejectRound"->firstRejectRound,
"StatePairCount"->Length[pairs],
"StatePairsNonEmpty"->(Length[pairs]>0),
"StatePairHash"->statePairHash,
"Codes"->codes,
"Prediction"->prediction,
"Correct"->SameQ[prediction,record["Target"]],
"ReferenceRowFound"->referenceFound,
"ReferenceStatePairsExact"->If[
referenceFound,
SameQ[statePairHash,referenceRow["StatePairHash"]],
False
],
"ReferenceCodesExact"->If[
referenceFound,
SameQ[codes,referenceRow["Codes"]],
False
],
"ReferenceTraceFound"->referenceTraceFound,
"ReferenceFirstRejectRoundExact"->If[
referenceTraceFound,
SameQ[
firstRejectRound,
referenceTraceRow["FirstRejectRound"]
],
False
]
|>
];

