ScaleDynamicCase78[record_Association]:=Module[
{
traceSeconds,trace,pairs,codes,prediction,statePairHash,
referenceRow,referenceTraceRow,referenceFound,
referenceTraceFound,allRejects,firstRejectRound
},
{traceSeconds,trace}=AbsoluteTiming[
RejectTrace78[record["Case"]]
];
allRejects=trace["Rejects"];
pairs=DecisionStatePairsFromRejects78[
record["Case"],
allRejects
];
