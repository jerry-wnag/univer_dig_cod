paths=FileNameJoin[{
"E:/engine_wolf/TCCT_S94H_R3_Checkpoints",
"scenario_"<>IntegerString[#,10,2]<>".wxf"
}]&/@{1,2,3,7,8,13,14,19};

rows=Map[Function[path,Module[{obj,recomputed},
obj=Quiet@Check[Import[path,"WXF"],$Failed];
If[!AssociationQ[obj],
<|"Path"->path,"Association"->False|>,
recomputed=Hash[Normal@KeyDrop[obj,{"CheckpointHash"}],"SHA256","HexString"];
<|
"Path"->path,
"Association"->True,
"ScenarioIndex"->obj["ScenarioIndex"],
"ExecutionMode"->obj["ExecutionMode"],
"CandidateHash"->obj["CandidateHash"],
"CandidateFileHash"->obj["CandidateFileHash"],
"ProtocolHash"->obj["ProtocolHash"],
"DefinitionHash"->obj["DefinitionHash"],
"PairCount"->obj["PairCount"],
"WorldCount"->obj["WorldCount"],
"ScenarioValidityPassed"->obj["ScenarioValidityPassed"],
"StoredCheckpointHash"->obj["CheckpointHash"],
"RecomputedCheckpointHash"->recomputed,
"CheckpointHashMatched"->SameQ[obj["CheckpointHash"],recomputed]
|>
]]],paths];

Print[InputForm[rows]];
Quit[];
