Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<\\n=== [Strict Correction] Dynamic BA Zero Model Class \
Empty Snapshot Blind Test ===\>\"", ",", "Purple", ",", "Bold", ",", "16"}], 
     "]"}], "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "\:786e\:4fdd", " ", "TCCT", " ", 
    "\:7684\:52a8\:6001\:5feb\:7167\:6570\:636e\:8fd8\:5728"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Not", "[", 
       RowBox[{"ValueQ", "[", "snapshots", "]"}], "]"}], "||", 
      RowBox[{"Not", "[", 
       RowBox[{"ValueQ", "[", "profile", "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{
      "Print", "[", "\"\<[Error] Unable to locate TCCT snapshot. Please rerun \
your concurrent engine code!\>\"", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"nodeN", "=", 
   RowBox[{"VertexCount", "[", "universe", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"edgeM", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"1", ",", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"EdgeCount", "[", "universe", "]"}], "/", "nodeN"}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"steps", "=", 
    RowBox[{"Length", "[", "snapshots", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"StringForm", "[", 
     RowBox[{"\"\<[1/3] Generate the BA model using strict dynamic \
snapshots... Steps: ``, Noise level m: ``\>\"", ",", "steps", ",", "edgeM"}], 
     "]"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baSnapshots", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"baGraph", "=", 
    RowBox[{"Graph", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"edgeM", "+", "1"}], "]"}], ",", 
      RowBox[{"UndirectedEdge", "@@@", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"edgeM", "+", "1"}], "]"}], ",", "2", ",", "1", ",", "1"}], 
        "]"}]}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", "\:521d\:59cb\:5c0f\:56fe", "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"BA", " ", "\:6f14\:5316"}], "\:ff1a", 
        "\:6bcf\:6b65\:52a0\:51651\:4e2a\:65b0\:8282\:70b9", "\:ff0c", 
        RowBox[{"\:8fde\:51fa", " ", "m", " ", "\:6761\:8fb9"}]}], "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"newNode", "=", 
         RowBox[{
          RowBox[{"VertexCount", "[", "baGraph", "]"}], "+", "1"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"existingNodes", "=", 
         RowBox[{"VertexList", "[", "baGraph", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"degrees", "=", 
         RowBox[{"VertexDegree", "[", "baGraph", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"probs", "=", 
         RowBox[{"degrees", "/", 
          RowBox[{"Total", "[", "degrees", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"targets", "=", 
         RowBox[{"RandomSample", "[", 
          RowBox[{
           RowBox[{"existingNodes", "->", "probs"}], ",", 
           RowBox[{"Min", "[", 
            RowBox[{"edgeM", ",", 
             RowBox[{"Length", "[", "existingNodes", "]"}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"newEdges", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"newNode", ",", "#"}], "]"}], "&"}], "/@", "targets"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"baGraph", "=", 
         RowBox[{"Graph", "[", 
          RowBox[{
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "baGraph", "]"}], ",", "newNode"}], 
            "]"}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"EdgeList", "[", "baGraph", "]"}], ",", "newEdges"}], 
            "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "\:7edd\:5bf9\:516c\:5e73\:7684\:5f53\:573a\:5feb\:7167", "\:ff1a", 
          "\:5f53\:524d\:8868\:9762\:7684\:4f53\:79ef\:548c\:8fde\:901a\:5ea6\
"}], "*)"}], 
        RowBox[{"volBA", "=", "1"}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "\:6bcf\:6b21\:65b0\:589e\:7684\:5f53\:4e0b\:7a7a\:95f4\:8282\:70b9\
\:6570\:4e3a", " ", "1"}], "*)"}], 
        RowBox[{"rhoBA", "=", 
         RowBox[{"Length", "[", "targets", "]"}]}], ";", 
        RowBox[{
        "(*", "\:5ef6\:4f38\:5411\:5386\:53f2\:7684\:56e0\:679c\:6c89\:6dc0\
\:8fb9\:6570", "*)"}], 
        RowBox[{"AppendTo", "[", 
         RowBox[{"baSnapshots", ",", 
          RowBox[{"{", 
           RowBox[{"volBA", ",", "rhoBA"}], "}"}]}], "]"}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "steps"}], "}"}]}], "]"}], ",", 
     RowBox[{"ProgressIndicator", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "steps"}], "}"}]}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<[2/3]Generate the BA model using strict dynamic \
snapshots... Steps: ``, Noise level m: `` Reverse the cosmological time axis, \
redraw the intrinsic evolution diagram...\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"historyBA", "=", 
   RowBox[{"Reverse", "[", "baSnapshots", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxR", "=", 
    RowBox[{
     RowBox[{"Length", "[", "historyBA", "]"}], "-", "1"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"baProfileDyn", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"historyBA", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"r", "+", "1"}], ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"historyBA", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"r", "+", "1"}], ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "maxR"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<\\n[3/3]Generating an absolutely fair comparison \
chart...\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotTCCT", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"profile", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Purple", ",", "Thick"}], "]"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{
      "{", "\"\<TCCT (Spontaneous Phase Transition: Halo and Core)\>\"", 
       "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plotBADyn", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"baProfileDyn", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Gray", ",", "Dashed", ",", "Thick"}], "]"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", "\"\<BA\>\"", "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"plotTCCT", ",", "plotBADyn"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"profile", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}], "*", "1.5"}]}], 
       "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Strictly dynamic hypersurface comparison: spontaneous \
emergence vs stagnant background noise\>\"", ",", "Bold", ",", "14"}], 
       "]"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Backward time r (Lookback Steps)\>\"", 
        ",", "\"\<Average historical accumulation (effective mass) of single \
slice\>\""}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "Large"}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "]"}], 
